# ============================================================
# .env.example — 配置模板
# 用法：复制成 .env 再填自己的值
#     cp .env.example .env
# .env 已被 .gitignore 挡住，不会进版本库；这个模板可以进。
# 所有项都有代码内默认值（见 backend/database.py、llm_client.py、qdrant_client.py），
# 不填也能跑，只是 LLM 会走规则兜底、MySQL 会用默认口令连。
# ============================================================

# ---------- LLM（DeepSeek）----------
# 不填则 is_llm_available() 为假，补货分析/文案生成自动降级到规则引擎
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=petstore_db

# ---------- Qdrant ----------
# 默认走本地嵌入式模式（backend/qdrant_client.py），QDRANT_PATH 不必填
QDRANT_HOST=localhost
QDRANT_PORT=6333
